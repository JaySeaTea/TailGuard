<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_surface"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_mesh_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/tile_label"
            android:src="@drawable/ic_tailguard_mesh"
            android:tint="#38BDF8" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_status_off"
            android:textAllCaps="true"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_widget_dot"
        android:tint="#64748B" />

</FrameLayout>
